<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/forgot_password_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/forgot_password_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="30dp"
        android:paddingBottom="30dp">

        <ImageView
            android:id="@+id/forgot_password_logo"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/logo"
            android:scaleType="fitCenter"
            android:contentDescription="@string/logo_description" />

        <TextView
            android:id="@+id/forgot_password_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/forgot_password_title"
            android:textSize="26sp"
            android:textColor="@color/coffee_primary"
            android:gravity="center"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/forgot_password_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/forgot_password_description"
            android:textSize="14sp"
            android:textColor="@color/coffee_primary"
            android:gravity="center"
            android:lineSpacingExtra="2dp" />

        <LinearLayout
            android:id="@+id/recovery_email_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="6dp"
                android:text="@string/email_label"
                android:textSize="12sp"
                android:textColor="@color/coffee_primary" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/recovery_email_input_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:boxBackgroundMode="outline"
                app:boxCornerRadiusTopStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusBottomEnd="12dp"
                app:startIconDrawable="@drawable/ic_mail">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/recovery_email_edit_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:singleLine="true"
                    android:imeOptions="actionDone"
                    android:autofillHints="emailAddress" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/reset_password_button"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="18dp"
            android:text="@string/reset_password_button"
            android:textSize="14sp"
            android:textColor="@color/text_light"
            android:textAllCaps="false"
            android:elevation="4dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/coffee_primary"
            app:cornerRadius="25dp"
            app:icon="@drawable/ic_arrow_right"
            app:iconTint="@color/text_light"
            app:iconSize="14dp"
            app:iconGravity="textEnd"
            app:iconPadding="14dp" />

        <LinearLayout
            android:id="@+id/back_to_sign_in_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/remembered_password"
                android:textSize="12sp"
                android:textColor="@color/coffee_primary" />

            <TextView
                android:id="@+id/back_to_sign_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/back_to_sign_in"
                android:textSize="12sp"
                android:textColor="@color/coffee_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
