<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <LinearLayout
        android:id="@+id/manager_header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/coffee_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_logo_circle"
            android:padding="4dp"
            android:src="@drawable/logo"
            android:contentDescription="@string/logo_description"
            android:scaleType="centerInside"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Karen Sophia Molina Díaz"
                android:textColor="@color/background_app"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gerente"
                android:textColor="#E6E2DD"
                android:textSize="12sp"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/manager_notifications_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_header_icon"
            android:src="@drawable/ic_notifications"
            android:contentDescription="@string/notifications"
            app:tint="@color/background_app"/>

        <ImageButton
            android:id="@+id/manager_profile_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_header_icon"
            android:src="@drawable/ic_user"
            android:contentDescription="@string/profile"
            app:tint="@color/background_app"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/manager_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/manager_header"
        app:layout_constraintBottom_toTopOf="@id/manager_bottom_navigation_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="26dp"
            android:paddingTop="26dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stat_total"
                    layout="@layout/item_user_stat"
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/stat_clients"
                    layout="@layout/item_user_stat"
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/stat_sales"
                    layout="@layout/item_user_stat"
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/stat_employees"
                    layout="@layout/item_user_stat"
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/create_user_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_user_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_user_plus"
                    android:contentDescription="@null"
                    app:tint="@color/coffee_primary"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Crear nuevo usuario"
                    android:textColor="@color/coffee_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/user_search_container"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_user_action"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <EditText
                    android:id="@+id/user_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="Buscar por nombre, correo o cédula"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#A3948D"
                    android:textSize="14sp"
                    android:padding="0dp"/>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search_users"
                    app:tint="#A3948D"/>

            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/user_filters_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:id="@+id/filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_filter_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_filter_all"
                            android:contentDescription="@null"
                            app:tint="#FFFFFF"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Todos (1.420)"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/filter_employees"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_filter_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_coffee"
                            android:contentDescription="@null"
                            app:tint="@color/coffee_secondary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Empleados (28)"
                            android:textColor="@color/coffee_primary"
                            android:textSize="14sp"/>

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/filter_clients"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_filter_unselected"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:paddingHorizontal="16dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user"
                            android:contentDescription="@null"
                            app:tint="@color/coffee_secondary"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Clientes (1.385)"
                            android:textColor="@color/coffee_primary"
                            android:textSize="14sp"/>

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/user_list_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:text="Usuarios globales"
                    android:textColor="@color/coffee_primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/user_records_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_user_count_badge"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="9dp"
                    android:text="1.420 Registros"
                    android:textColor="@color/coffee_primary"
                    android:textSize="12sp"/>

                <LinearLayout
                    android:id="@+id/sort_users_button"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_user_sort"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:src="@drawable/ic_sort_az"
                        android:contentDescription="@null"
                        app:tint="@color/coffee_secondary"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Ordenar A-Z"
                        android:textColor="@color/coffee_secondary"
                        android:textSize="12sp"/>

                </LinearLayout>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/users_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:clipToPadding="false"/>

            <LinearLayout
                android:id="@+id/user_pagination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/previous_page_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pagination_button"
                    android:contentDescription="@string/previous_page"
                    android:padding="13dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#A3948D"
                    app:elevation="3dp"/>

                <TextView
                    android:id="@+id/current_page_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Página 1 de 20"
                    android:textColor="#A3948D"
                    android:textSize="14sp"/>

                <ImageButton
                    android:id="@+id/next_page_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pagination_button"
                    android:contentDescription="@string/next_page"
                    android:padding="13dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#A3948D"
                    app:elevation="3dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/manager_bottom_navigation_container"
        layout="@layout/view_manager_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
