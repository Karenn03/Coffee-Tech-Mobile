<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:background="@color/background_app">

    <LinearLayout
        android:id="@+id/product_header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/coffee_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:elevation="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_logo_circle"
            android:contentDescription="@string/logo_description"
            android:padding="4dp"
            android:src="@drawable/logo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Karen Sophia Molina Díaz"
                android:textColor="@color/background_app"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gerente"
                android:textColor="#E6E2DD"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_header_icon"
            android:contentDescription="@string/notifications"
            android:src="@drawable/ic_notifications"
            app:tint="@color/background_app" />

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_header_icon"
            android:contentDescription="@string/profile"
            android:src="@drawable/ic_user"
            app:tint="@color/background_app" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/product_bottom_navigation"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/product_header">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="26dp"
            android:paddingTop="26dp"
            android:paddingBottom="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/product_stat_hot"
                    layout="@layout/item_user_stat"
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/product_stat_cold"
                    layout="@layout/item_user_stat"
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <include
                    android:id="@+id/product_stat_bakery"
                    layout="@layout/item_user_stat"
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <include
                    android:id="@+id/product_stat_breakfast"
                    layout="@layout/item_user_stat"
                    android:layout_width="0dp"
                    android:layout_height="94dp"
                    android:layout_weight="1" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/create_product_button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_user_action"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_plus"
                    app:tint="@color/coffee_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/create_product"
                    android:textColor="@color/coffee_primary"
                    android:textSize="16sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/product_search_container"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_user_action"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="18dp">

                <EditText
                    android:id="@+id/product_search_input"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search_products"
                    android:inputType="text"
                    android:singleLine="true"
                    android:textColor="@color/text_dark"
                    android:textColorHint="#A3948D"
                    android:textSize="14sp"
                    android:padding="0dp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_search"
                    android:contentDescription="@string/search_products"
                    app:tint="#A3948D" />

            </LinearLayout>

            <FrameLayout
                android:id="@+id/product_filters_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipChildren="true"
                android:clipToPadding="true">

                <HorizontalScrollView
                    android:id="@+id/product_filters_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="true"
                    android:clipToPadding="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/product_filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@drawable/bg_filter_selected">

                            <ImageView
                                android:id="@+id/product_filter_all_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_filter_all"
                                android:contentDescription="@null"
                                app:tint="#FFFFFF"/>

                            <TextView
                                android:id="@+id/product_filter_all_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Todos"
                                android:textColor="#FFFFFF"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/product_filter_hot"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_filter_unselected">

                            <ImageView
                                android:id="@+id/product_filter_hot_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_coffee"
                                android:contentDescription="@null"
                                app:tint="@color/coffee_secondary"/>

                            <TextView
                                android:id="@+id/product_filter_hot_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Bebidas calientes (14)"
                                android:textColor="@color/coffee_primary"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/product_filter_cold"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_filter_unselected">

                            <ImageView
                                android:id="@+id/product_filter_cold_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_snowflake"
                                android:contentDescription="@null"
                                app:tint="@color/coffee_secondary"/>

                            <TextView
                                android:id="@+id/product_filter_cold_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Bebidas frías (14)"
                                android:textColor="@color/coffee_primary"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/product_filter_bakery"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_filter_unselected">

                            <ImageView
                                android:id="@+id/product_filter_bakery_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_croissant"
                                android:contentDescription="@null"
                                app:tint="@color/coffee_secondary"/>

                            <TextView
                                android:id="@+id/product_filter_bakery_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Panadería y pastelería (24)"
                                android:textColor="@color/coffee_primary"/>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/product_filter_breakfast"
                            android:layout_width="wrap_content"
                            android:layout_height="44dp"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_filter_unselected"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="16dp"
                            android:clickable="true"
                            android:focusable="true">

                            <ImageView
                                android:id="@+id/product_filter_breakfast_icon"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_sandwich"
                                android:contentDescription="@null"
                                app:tint="@color/coffee_secondary"/>

                            <TextView
                                android:id="@+id/product_filter_breakfast_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="14sp"
                                android:fontFamily="sans-serif-medium"
                                android:text="Desayunos y brunch (25)"
                                android:textColor="@color/coffee_primary"/>

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>

            </FrameLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/products_recycler_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never" />

            <LinearLayout
                android:id="@+id/product_pagination"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/product_previous_page_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pagination_button"
                    android:contentDescription="@string/previous_page"
                    android:padding="13dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="#A3948D"
                    app:elevation="3dp"/>

                <TextView
                    android:id="@+id/product_current_page_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Página 1 de 1"
                    android:textColor="#A3948D"
                    android:textSize="14sp"/>

                <ImageButton
                    android:id="@+id/product_next_page_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_pagination_button"
                    android:contentDescription="@string/next_page"
                    android:padding="13dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="#A3948D"
                    app:elevation="3dp"/>

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/product_bottom_navigation"
        layout="@layout/view_manager_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
