<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <LinearLayout
        android:id="@+id/home_header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/coffee_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_logo_circle"
            android:padding="4dp"
            android:src="@drawable/logo"
            android:contentDescription="@string/logo_description"
            android:scaleType="centerInside" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/customer_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Karen Sophia Molina Díaz"
                android:textColor="@color/background_app"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cliente"
                android:textColor="#E6E2DD"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/notifications_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_header_icon"
            android:src="@drawable/ic_notifications"
            android:contentDescription="Notificaciones"
            app:tint="@color/background_app" />

        <ImageButton
            android:id="@+id/profile_button"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_header_icon"
            android:src="@drawable/ic_user"
            android:contentDescription="Mi perfil"
            app:tint="@color/background_app" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/home_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/home_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="30dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/delivery_location_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/background_app"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:strokeColor="#E5D6C8"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_location_icon"
                        android:padding="10dp"
                        android:src="@drawable/ic_map_pin"
                        android:contentDescription="Ubicación de entrega"
                        app:tint="@color/coffee_secondary" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ENTREGAR EN"
                            android:textColor="@color/coffee_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/delivery_address"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cl. 138 #11b-16, Bogotá"
                            android:textColor="@color/text_dark"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:maxLines="1" />

                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/change_location_button"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:background="@drawable/bg_location_button"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="Cambiar ubicación"
                        app:tint="@color/coffee_secondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
