<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/seller_bottom_navigation_container"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/seller_navigation_background"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:scaleType="fitXY"
        android:src="@drawable/bg_seller_bottom_navigation_home"
        android:contentDescription="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <ImageButton
        android:id="@+id/seller_home_navigation_button"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_home_nav_button"
        android:contentDescription="@string/seller_nav_home"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_home"
        android:elevation="6dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.15"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/background_app" />

    <ImageButton
        android:id="@+id/seller_products_navigation_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/seller_nav_products"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_hand_platter"
        app:tint="@color/background_app"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        android:layout_marginBottom="8dp" />

    <ImageButton
        android:id="@+id/seller_orders_navigation_button"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/seller_nav_orders"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_receipt"
        app:tint="@color/background_app"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.85"
        android:layout_marginBottom="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
