<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginTop="24dp"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="24dp"
    app:cardElevation="3dp"
    app:strokeColor="#EAD9CA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="22dp"
        android:paddingTop="32dp"
        android:paddingBottom="30dp">

        <FrameLayout
            android:layout_width="116dp"
            android:layout_height="116dp"
            android:background="@drawable/bg_cart_empty_icon">

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_coffee"
                android:contentDescription="@null"
                app:tint="@color/coffee_primary" />

        </FrameLayout>

        <TextView
            android:id="@+id/cart_empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="@string/cart_empty_title"
            android:textColor="@color/coffee_primary"
            android:textSize="21sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/cart_empty_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/cart_empty_description"
            android:textColor="@color/coffee_secondary"
            android:textSize="14sp"
            android:lineSpacingExtra="5dp" />

        <LinearLayout
            android:id="@+id/cart_explore_products_button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_create_activate_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="@string/cart_explore_products"
                android:textColor="@color/background_app"
                android:textSize="15sp"
                android:fontFamily="sans-serif" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                android:contentDescription="@null"
                app:tint="@color/background_app" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="@string/cart_empty_footer"
            android:textColor="@color/coffee_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
