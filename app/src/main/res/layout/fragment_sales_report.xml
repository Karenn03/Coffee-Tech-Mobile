<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/report_header"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:background="@color/coffee_primary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_logo_circle"
            android:padding="4dp"
            android:scaleType="centerInside"
            android:src="@drawable/logo"
            android:contentDescription="@string/logo_description" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Karen Sophia Molina Díaz"
                android:textColor="@color/background_app"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gerente"
                android:textColor="#E6E2DD"
                android:textSize="12sp" />

        </LinearLayout>

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_header_icon"
            android:src="@drawable/ic_notifications"
            android:contentDescription="@string/notifications"
            app:tint="@color/background_app" />

        <ImageButton
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_header_icon"
            android:src="@drawable/ic_user"
            android:contentDescription="@string/profile"
            app:tint="@color/background_app" />

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/report_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toBottomOf="@id/report_header"
        app:layout_constraintBottom_toTopOf="@id/report_bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingHorizontal="26dp"
            android:paddingTop="24dp"
            android:paddingBottom="42dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_title"
                android:textColor="@color/coffee_primary"
                android:textSize="28sp"
                android:fontFamily="sans-serif-condensed"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/report_subtitle"
                android:textColor="@color/coffee_primary"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_user_count_badge"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:text="@string/report_period"
                android:textColor="@color/coffee_primary"
                android:textSize="12sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:clipChildren="true"
                android:clipToPadding="true">

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:overScrollMode="never">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/report_filter_all"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:background="@drawable/bg_filter_selected"
                            android:gravity="center"
                            android:minWidth="85dp"
                            android:paddingHorizontal="18dp"
                            android:text="@string/report_filter_all"
                            android:textColor="@color/background_app"
                            android:textSize="13sp"
                            android:fontFamily="sans-serif-medium"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/report_filter_completed"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_dashboard_filter_unselected"
                            android:gravity="center"
                            android:paddingHorizontal="18dp"
                            android:text="@string/report_filter_completed"
                            android:textColor="@color/coffee_primary"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/report_filter_pending"
                            android:layout_width="wrap_content"
                            android:layout_height="46dp"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/bg_dashboard_filter_unselected"
                            android:gravity="center"
                            android:paddingHorizontal="18dp"
                            android:text="@string/report_filter_pending"
                            android:textColor="@color/coffee_primary"
                            android:textSize="13sp"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>

                </HorizontalScrollView>

            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@color/coffee_primary"
                app:cardCornerRadius="24dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_dashboard_revenue_gradient">

                    <ImageView
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-40dp"
                        android:layout_marginEnd="-48dp"
                        android:src="@drawable/bg_dashboard_revenue_decoration"
                        android:contentDescription="@null" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:src="@drawable/ic_file_chart"
                                android:contentDescription="@null"
                                app:tint="#F0BC8F" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="9dp"
                                android:layout_weight="1"
                                android:text="@string/report_confirmed_revenue"
                                android:textColor="#E6D9D2"
                                android:textSize="12sp"
                                android:fontFamily="sans-serif-medium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_user_count_badge"
                                android:paddingHorizontal="11dp"
                                android:paddingVertical="7dp"
                                android:text="@string/dashboard_audit_demo"
                                android:textColor="@color/coffee_primary"
                                android:textSize="11sp"
                                android:fontFamily="sans-serif-medium" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/report_total_amount"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:textColor="@color/background_app"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="@string/report_revenue_caption"
                            android:textColor="#D9BFB2"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="22dp"
                            android:layout_marginBottom="16dp"
                            android:background="#795750" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_dashboard_revenue_metric"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_file_chart"
                                    android:contentDescription="@null"
                                    app:tint="#F0BC8F" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/report_completed"
                                    android:textColor="#D9BFB2"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/report_completed_count"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textColor="@color/background_app"
                                    android:textSize="23sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/report_completed_caption"
                                    android:textColor="#F0BC8F"
                                    android:textSize="11sp" />

                            </LinearLayout>

                            <Space
                                android:layout_width="10dp"
                                android:layout_height="1dp" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:background="@drawable/bg_dashboard_revenue_metric"
                                android:orientation="vertical"
                                android:padding="13dp">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:src="@drawable/ic_notifications"
                                    android:contentDescription="@null"
                                    app:tint="#F0BC8F" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:text="@string/report_pending"
                                    android:textColor="#D9BFB2"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/report_pending_count"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:textColor="@color/background_app"
                                    android:textSize="23sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/report_pending_caption"
                                    android:textColor="#F0BC8F"
                                    android:textSize="11sp" />

                            </LinearLayout>

                        </LinearLayout>

                    </LinearLayout>

                </FrameLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/report_transactions"
                    android:textColor="@color/coffee_primary"
                    android:textSize="19sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/report_results_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_user_count_badge"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp"
                    android:textColor="@color/coffee_primary"
                    android:textSize="12sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/report_transactions_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:clipChildren="false"
                android:clipToPadding="false" />

            <LinearLayout
                android:id="@+id/report_export_button"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_create_activate_button"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_file_chart"
                    android:contentDescription="@null"
                    app:tint="@color/background_app" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="@string/report_export"
                    android:textColor="@color/background_app"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif" />

            </LinearLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <include
        android:id="@+id/report_bottom_navigation"
        layout="@layout/view_manager_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="82dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
