<?xml version="1.0" encoding="utf-8"?>
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_nav_graph"
    app:startDestination="@id/homeFragment">


    <!-- ................................................................................. -->


    <fragment
        android:id="@+id/sign_in_fragment"
        android:name="com.example.coffeetechmobile.ui.auth.SignInFragment"
        android:label="Iniciar sesión">

        <action
            android:id="@+id/action_sign_in_to_sign_up"
            app:destination="@id/sign_up_fragment" />

        <action
            android:id="@+id/action_sign_in_to_forgot_password"
            app:destination="@id/forgot_password_fragment" />

    </fragment>

    <fragment
        android:id="@+id/sign_up_fragment"
        android:name="com.example.coffeetechmobile.ui.auth.SignUpFragment"
        android:label="Registrarse" />

    <fragment
        android:id="@+id/forgot_password_fragment"
        android:name="com.example.coffeetechmobile.ui.auth.ForgotPasswordFragment"
        android:label="Recuperar contraseña" />

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.coffeetechmobile.ui.profile.ProfileFragment"
        android:label="Mi perfil">

        <argument
            android:name="profile_role"
            app:argType="string"
            android:defaultValue="BUYER" />
        <!-- SELLER -->

    </fragment>


    <!-- ................................................................................. -->


    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.coffeetechmobile.ui.home.HomeFragment"
        android:label="Home">

        <action
            android:id="@+id/action_homeFragment_to_productDetailFragment"
            app:destination="@id/productDetailFragment" />

    </fragment>

    <!-- Detalle del producto -->
    <fragment
        android:id="@+id/productDetailFragment"
        android:name="com.example.coffeetechmobile.ui.buyer.catalog.ProductDetailFragment"
        android:label="Detalle del producto">

        <argument
            android:name="product_id"
            app:argType="integer" />

    </fragment>

    <!-- Carrito de compras -->
    <fragment
        android:id="@+id/cartFragment"
        android:name="com.example.coffeetechmobile.ui.buyer.cart.CartFragment"
        android:label="Carrito de compras">

        <action
            android:id="@+id/action_cartFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />

    </fragment>

    <!-- Pasarela de pagos -->
    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.example.coffeetechmobile.ui.buyer.payment.PaymentFragment"
        android:label="Proceso de pago" />


    <!-- ................................................................................. -->


    <!-- Dashboard principal del administrador -->
    <fragment
        android:id="@+id/adminDashboardFragment"
        android:name="com.example.coffeetechmobile.ui.manager.dashboard.AdminDashboardFragment"
        android:label="Panel general" />

    <!-- Gestión de usuarios -->
    <fragment
        android:id="@+id/userManagementFragment"
        android:name="com.example.coffeetechmobile.ui.manager.users.UserManagementFragment"
        android:label="Gestión de usuarios">

        <action
            android:id="@+id/action_userManagementFragment_to_createUserFragment"
            app:destination="@id/createUserFragment" />

    </fragment>

    <fragment
        android:id="@+id/createUserFragment"
        android:name="com.example.coffeetechmobile.ui.manager.users.CreateUserFragment"
        android:label="Nuevo usuario" />

    <!-- Gestión de productos -->
    <fragment
        android:id="@+id/productManagementFragment"
        android:name="com.example.coffeetechmobile.ui.manager.products.ProductManagementFragment"
        android:label="Gestión de productos">

        <action
            android:id="@+id/action_productManagementFragment_to_createProductFragment"
            app:destination="@id/createProductFragment" />
    </fragment>

    <fragment
        android:id="@+id/createProductFragment"
        android:name="com.example.coffeetechmobile.ui.manager.products.CreateProductFragment"
        android:label="Nuevo producto" />

    <!-- Reporte de ventas del administrador -->
    <fragment
        android:id="@+id/salesReportFragment"
        android:name="com.example.coffeetechmobile.ui.manager.reports.SalesReportFragment"
        android:label="Reporte de ventas" />


    <!-- ................................................................................. -->


    <!-- Historial de pedidos del vendedor -->
    <fragment
        android:id="@+id/sellerOrdersFragment"
        android:name="com.example.coffeetechmobile.ui.seller.orders.SellerOrdersFragment"
        android:label="Pedidos recibidos" />



</navigation>
