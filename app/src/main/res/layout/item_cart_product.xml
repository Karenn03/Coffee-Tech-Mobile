<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="2dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="22dp"
    app:cardElevation="3dp"
    app:strokeColor="#EAD9CA"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="96dp"
                android:layout_height="104dp"
                android:background="@drawable/bg_product_image">

                <ImageView
                    android:id="@+id/cart_item_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/product_image" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/cart_item_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_dark"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/cart_item_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textColor="@color/coffee_secondary"
                    android:textSize="12sp"
                    android:maxLines="2"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/cart_item_unit_price"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/coffee_secondary"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageButton
                android:id="@+id/cart_item_delete_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cart_delete_button"
                android:padding="8dp"
                android:src="@drawable/ic_trash"
                app:tint="@color/coffee_secondary" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="12dp"
            android:background="#EAD9CA" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/cart_item_decrease_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_cart_quantity_button"
                android:gravity="center"
                android:text="−"
                android:textColor="@color/coffee_primary"
                android:textSize="22sp"
                android:contentDescription="@string/cart_quantity_decrease"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/cart_item_quantity"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/text_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cart_item_increase_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_cart_quantity_button"
                android:gravity="center"
                android:text="+"
                android:textColor="@color/coffee_primary"
                android:textSize="21sp"
                android:contentDescription="@string/cart_quantity_increase"
                android:clickable="true"
                android:focusable="true" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/cart_item_total_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_dark"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
